<Window x:Class="GameMonitorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameMonitorApp"
        mc:Ignorable="d"
        Title="Performance Manager"
        Height="450"
        Width="800">

   <Grid>
        <StackPanel>
            <TextBlock x:Name="CpuTextBlock" Text="CPU Usage:" FontSize="16" FontWeight="Medium" Margin="0,0,0,5"/>
            
            <TextBlock x:Name="RamTextBlock" Text="RAM Usage:" FontSize="16" FontWeight="Medium" Margin="0,0,0,25"/>
            
            <TextBlock Text="Most RAM Usage" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <ListBox x:Name="ProcessListBox" Height="260" FontSize="14" FontFamily="Consolas"/>
        </StackPanel>
    </Grid>
</Window>
